# Variables de entorno del despliegue en EC2. Copiar a .env junto a docker-compose.yml y completar.
# .env está ignorado por git: ningún secreto se versiona (RNF03). Formato de Docker: una variable por línea, sin
# comillas y sin comentarios al final de la línea.

# --- Base de datos (Amazon RDS for PostgreSQL 15 o superior) ---
# sslmode=verify-full valida el certificado de RDS con el paquete que trae la imagen
KOMAINOS_DB_URL=jdbc:postgresql://<endpoint-rds>.rds.amazonaws.com:5432/komainos?sslmode=verify-full&sslrootcert=/opt/komainos/rds-ca/global-bundle.pem
KOMAINOS_DB_USUARIO=
KOMAINOS_DB_CLAVE=
KOMAINOS_DB_POOL_MAXIMO=10

# --- Seguridad ---
# Llave HMAC de al menos 32 bytes, distinta de la de desarrollo: openssl rand -base64 32
KOMAINOS_JWT_SECRETO=
# Llave maestra AES-256 de las credenciales: openssl rand -base64 32. Respaldarla fuera del servidor: si se pierde o
# cambia, las cuentas de servicio y credenciales registradas no se pueden descifrar
KOMAINOS_CREDENCIALES_LLAVE=
# Primer administrador: solo se crea si la base no tiene ninguno activo (DEC-21). Vaciarla después del primer inicio
KOMAINOS_ADMIN_CODIGO=admin
KOMAINOS_ADMIN_NOMBRE=Administrador del sistema
KOMAINOS_ADMIN_CLAVE_INICIAL=
# URL pública con la que los usuarios abren el panel (por ejemplo https://komainos.midominio.com o http://<ip-publica>)
KOMAINOS_CORS_ORIGENES=https://komainos.midominio.com

# --- Operación ---
KOMAINOS_ZONA_HORARIA=America/Lima
# Puerto del host EC2 en el que se publica el contenedor (docker-compose.yml)
KOMAINOS_PUERTO_PUBLICO=80
# Dejar en false hasta verificar el acceso a los servidores (DESPLIEGUE.md, «Primera puesta en marcha»)
KOMAINOS_AUTOMATIZACION_PROCESO_HABILITADO=false
KOMAINOS_AUTOMATIZACION_INTERVALO_MS=30000
KOMAINOS_AUTOMATIZACION_MAX_CONEXIONES=10
# Swagger y el contrato OpenAPI solo si se necesitan: true los publica en /swagger-ui.html
KOMAINOS_API_DOCS=false

# --- Transporte hacia los servidores gestionados ---
KOMAINOS_ANSIBLE_TIMEOUT_CONEXION=30
KOMAINOS_ANSIBLE_SSH_PUERTO=22
KOMAINOS_ANSIBLE_SSH_VERIFICAR_CLAVE_HOST=true
KOMAINOS_ANSIBLE_WINRM_PUERTO=5986
KOMAINOS_ANSIBLE_WINRM_ESQUEMA=https
KOMAINOS_ANSIBLE_WINRM_TRANSPORTE=ntlm
KOMAINOS_ANSIBLE_WINRM_VALIDAR_CERTIFICADO=true
