# Copiar a .env y completar: .env está ignorado por git porque ningún secreto se versiona (RNF03)

KOMAINOS_DB_URL=jdbc:postgresql://localhost:5432/DBKomainOS
KOMAINOS_DB_USUARIO=postgres
KOMAINOS_DB_CLAVE=

# Llave HMAC de al menos 32 bytes, distinta por entorno: openssl rand -base64 32
KOMAINOS_JWT_SECRETO=

# Llave maestra AES-256 de las credenciales: si se pierde o cambia, los secretos guardados no se pueden descifrar
KOMAINOS_CREDENCIALES_LLAVE=

# Primer administrador: solo se usa si no existe ninguno (DEC-21)
KOMAINOS_ADMIN_CODIGO=admin
KOMAINOS_ADMIN_CLAVE_INICIAL=

KOMAINOS_CORS_ORIGENES=http://localhost:5180
KOMAINOS_PUERTO=8081
KOMAINOS_ZONA_HORARIA=America/Lima

# Pruebas de integración: una base distinta de la de desarrollo, porque borran y recrean su esquema
KOMAINOS_TEST_DB_URL=jdbc:postgresql://localhost:5432/dbkomainos_test
KOMAINOS_TEST_DB_USUARIO=postgres
KOMAINOS_TEST_DB_CLAVE=
