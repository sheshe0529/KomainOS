# Copiar a .env y completar. El archivo .env esta ignorado por git a proposito:
# ningun secreto del sistema debe existir en el repositorio (RNF03).
# application.yml lo importa automaticamente (spring.config.import).

KOMAINOS_DB_URL=jdbc:postgresql://localhost:5432/DBKomainOS
KOMAINOS_DB_USUARIO=postgres
KOMAINOS_DB_CLAVE=

# Llave HMAC para firmar los tokens. Debe decodificar a 32 bytes o mas.
# Generar una distinta por entorno:  openssl rand -base64 32
KOMAINOS_JWT_SECRETO=

# Contrasena del primer administrador. Solo se usa si la tabla usuario no tiene
# ningun administrador; despues puede eliminarse de este archivo (DEC-21).
KOMAINOS_ADMIN_CODIGO=admin
KOMAINOS_ADMIN_CLAVE_INICIAL=

KOMAINOS_CORS_ORIGENES=http://localhost:5180
KOMAINOS_PUERTO=8081
KOMAINOS_ZONA_HORARIA=America/Lima

# Solo para las pruebas de integracion (mvn verify -Pintegracion). Debe apuntar
# a una base distinta de la de desarrollo: las pruebas borran y recrean su esquema KomainOS.
KOMAINOS_TEST_DB_URL=jdbc:postgresql://localhost:5432/dbkomainos_test
KOMAINOS_TEST_DB_USUARIO=postgres
KOMAINOS_TEST_DB_CLAVE=
